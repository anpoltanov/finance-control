# Database (used by docker-compose stack)
POSTGRES_DB=finance_control
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-strong-password

# Django
SECRET_KEY=change-me-long-random-secret-key
DEBUG=false
BEHIND_PROXY=true
ALLOWED_HOSTS=finance.example.com
CSRF_TRUSTED_ORIGINS=https://finance.example.com
CORS_ALLOWED_ORIGINS=https://finance.example.com
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
TIME_ZONE=Europe/Moscow

# Direct WAN (TLS on this host, no upstream Apache): set BEHIND_PROXY=false
# and USE_HSTS=true. Leave BEHIND_PROXY=true when Apache on another machine
# terminates HTTPS and proxies to this container over HTTP.
# USE_HSTS=false
# SECURE_SSL_REDIRECT=false

# Stack — published on all interfaces so a proxy on another LAN host can reach it.
# Do not forward 8080 or 5432 through WAN NAT/firewall.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# MCP server (optional). Leave empty on the public API. A set token is a full
# API bypass for the first user (or MCP_USERNAME) until you rotate it.
MCP_API_TOKEN=
# MCP_USERNAME=

# Local dev (without Docker)
DATABASE_URL=postgresql://finance:change-me-strong-password@localhost:5432/finance_control
