# Database (used by docker-compose stack)
POSTGRES_DB=finance_control
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-strong-password

# Django
SECRET_KEY=change-me-long-random-secret-key
DEBUG=false
ALLOWED_HOSTS=finance.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://finance.example.com
CORS_ALLOWED_ORIGINS=https://finance.example.com
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
TIME_ZONE=Europe/Moscow

# Stack
WEB_PORT=8080

# MCP server (optional, for local AI agents)
MCP_API_TOKEN=change-me-mcp-token

# Local dev (without Docker)
DATABASE_URL=postgresql://finance:change-me-strong-password@localhost:5432/finance_control
